# Anthropic Claude için (opsiyonel)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI için (opsiyonel)
OPENAI_API_KEY=sk-xxxxx

# Groq için (ücretsiz - önerilen)
# https://console.groq.com adresinden oluştur
GROQ_API_KEY=gsk_xxxxx

# GitHub Personal Access Token (zorunlu - rate limit için)
# https://github.com/settings/tokens adresinden oluştur
# Sadece "public_repo" izni yeterli
GITHUB_TOKEN=ghp_xxxxx

# Hangi model kullanılacak: groq, anthropic veya openai
LLM_PROVIDER=groq
